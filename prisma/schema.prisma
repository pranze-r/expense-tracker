generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// DEBIT = money going out (an expense), CREDIT = money coming in
enum TransactionType {
  DEBIT
  CREDIT
}

// LENT = you gave money to someone (they owe you), BORROWED = you took money
// from someone (you owe them)
enum LoanDirection {
  LENT
  BORROWED
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships BookMember[]
  loans       Loan[]
}

model Book {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      BookMember[]
  categories   Category[]
  transactions Transaction[]
  invites      BookInvite[]
}

model BookInvite {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  role      Role      @default(EDITOR)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
}

model BookMember {
  id       String   @id @default(uuid())
  role     Role     @default(EDITOR)
  joinedAt DateTime @default(now())
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([bookId, userId])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  color        String?
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId       String
  transactions Transaction[]

  @@unique([bookId, name])
}

model Transaction {
  id              String          @id @default(uuid())
  amount          Float
  type            TransactionType @default(DEBIT)
  note            String?
  date            DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUserId String?
  book            Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          String
  category        Category?       @relation(fields: [categoryId], references: [id])
  categoryId      String?
}

// A personal record of money lent to, or borrowed from, one person. Private to
// the user who created it (not shared through books).
model Loan {
  id        String        @id @default(uuid())
  person    String
  direction LoanDirection
  amount    Float
  note      String?
  date      DateTime      @default(now())
  dueDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  payments  LoanPayment[]

  @@index([userId])
}

// Money paid back against a loan (in part or in full)
model LoanPayment {
  id        String   @id @default(uuid())
  amount    Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId    String

  @@index([loanId])
}
